# Copy this file to `.dev.vars` and fill in your values.
# `.dev.vars` is git-ignored — never commit real secrets.
#
# Local dev notes:
# - The Cloudflare Vite plugin serves the SPA and the Worker API from ONE
#   dev server on http://localhost:8787. APP_ORIGIN must match it.
# - GitHub OAuth requires a publicly reachable redirect URL, so for local
#   testing add http://localhost:8787/api/auth/callback to your GitHub
#   OAuth App's callback URLs (GitHub allows up to 10) or use a tunnel.
# - ALLOWED_GITHUB_USER_ID is your numeric GitHub user id (a username won't
#   match). Get it with no auth by opening
#   https://api.github.com/users/<your-username> and reading the "id" field.

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
ALLOWED_GITHUB_USER_ID=your_numeric_github_user_id
APP_ORIGIN=http://localhost:8787

# --- Browser push notifications (optional) ---
# `bun run setup` generates and fills these in automatically; below is how to
# do it by hand.
#
# Generate a VAPID key pair ONCE (it must stay stable so existing
# subscriptions remain valid across redeploys):
#
#   bunx web-push generate-vapid-keys --json
#
# Then paste the public/private keys below. For a single-user personal app,
# VAPID_SUBJECT is a mailto: or https:// URI identifying you, e.g.
# mailto:you@example.com.
#
# The PRIVATE key is a server secret — it never leaves the server and must
# never be committed. The PUBLIC key is served to the browser (the Push API
# requires it).
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
