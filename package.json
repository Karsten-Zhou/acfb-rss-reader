{
	"name": "acfb-rss-reader",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.7",
	"overrides": {
		"fast-xml-parser": "^5.11.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "vite build && wrangler deploy",
		"setup": "bun run scripts/setup.ts",
		"db:migrate": "wrangler d1 migrations apply rss-reader-db --local",
		"db:generate": "cd server/db && drizzle-kit generate",
		"db:studio": "cd server/db && drizzle-kit studio",
		"cf-typegen": "wrangler types",
		"typecheck:server": "tsc -p tsconfig.server.json --noEmit",
		"typecheck:app": "vue-tsc --noEmit -p tsconfig.app.json",
		"typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
		"typecheck": "bun run typecheck:server && bun run typecheck:app && bun run typecheck:scripts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "bun test"
	},
	"dependencies": {
		"@extractus/feed-extractor": "^8.0.3",
		"@formatjs/intl-localematcher": "^0.9.0",
		"@lucide/vue": "^1.52.0",
		"@tanstack/vue-query": "^5.104.1",
		"@vue/devtools-api": "^8.2.1",
		"@vueuse/core": "^15.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.23",
		"dompurify": "^3.4.16",
		"drizzle-orm": "^0.45.3",
		"fast-xml-parser": "^5.11.2",
		"hono": "^4.13.13",
		"pinia": "^4.0.3",
		"reka-ui": "^2.11.0",
		"striptags": "^3.2.0",
		"tailwind-merge": "^3.7.0",
		"vue": "^3.5.43",
		"vue-draggable-plus": "^0.6.1",
		"vue-i18n": "^11.4.13",
		"vue-router": "^5.3.1",
		"vue-virtual-scroller": "^3.0.5",
		"web-push": "^3.6.7",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vite-plugin": "^1.62.5",
		"@cloudflare/workers-types": "^5.20261005.1",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/web-push": "^3.6.4",
		"@vitejs/plugin-vue": "^6.0.9",
		"drizzle-kit": "^0.31.11",
		"lefthook": "^2.1.17",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"unplugin-auto-import": "^21.1.0",
		"unplugin-vue-components": "^32.1.0",
		"vite": "^8.3.2",
		"vue-tsc": "^3.3.12",
		"wrangler": "^4.147.0"
	}
}
