{
	"name": "cloudflare-based-rss-reader",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.7",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "vite build && wrangler deploy",
		"db:migrate": "wrangler d1 migrations apply rss-reader-db --local",
		"db:generate": "cd server/db && drizzle-kit generate",
		"db:studio": "cd server/db && drizzle-kit studio",
		"cf-typegen": "wrangler types",
		"typecheck": "tsc -p tsconfig.server.json --noEmit && vue-tsc --noEmit -p tsconfig.app.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "bun test"
	},
	"dependencies": {
		"@extractus/feed-extractor": "^8.0.0",
		"@tanstack/vue-query": "^5.0.0",
		"@vueuse/core": "^13.0.0",
		"@vueuse/motion": "^3.0.0",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"dompurify": "^3.2.0",
		"drizzle-orm": "^0.44.0",
		"fast-xml-parser": "^5.0.0",
		"hono": "^4.6.0",
		"lucide-vue-next": "^0.525.0",
		"pinia": "^3.0.0",
		"reka-ui": "^2.1.0",
		"striptags": "^3.2.0",
		"tailwind-merge": "^3.0.0",
		"vue": "^3.5.0",
		"vue-draggable-plus": "^0.6.1",
		"vue-i18n": "^11.4.8",
		"vue-router": "^4.5.0",
		"vue-virtual-scroller": "^2.0.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@cloudflare/vite-plugin": "^1.0.0",
		"@cloudflare/workers-types": "^4.20250520.0",
		"@commitlint/cli": "^19.0.0",
		"@commitlint/config-conventional": "^19.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@vitejs/plugin-vue": "^6.0.0",
		"drizzle-kit": "^0.31.0",
		"lefthook": "^1.11.0",
		"tailwindcss": "^4.0.0",
		"typescript": "~5.9.3",
		"vite": "^7.0.0",
		"vue-tsc": "^3.0.0",
		"wrangler": "^4.0.0"
	}
}
