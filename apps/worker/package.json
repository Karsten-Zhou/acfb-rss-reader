{
	"name": "@rss/worker",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "vite build && wrangler deploy",
		"db:migrate": "wrangler d1 migrations apply rss-reader-db --local",
		"cf-typegen": "wrangler types",
		"typecheck": "bun run typecheck:server && bun run typecheck:client",
		"typecheck:server": "tsc --noEmit",
		"typecheck:client": "vue-tsc --noEmit -p tsconfig.app.json"
	},
	"dependencies": {
		"@rss/api": "workspace:*",
		"@rss/compatibility": "workspace:*",
		"@rss/database": "workspace:*",
		"@rss/feeds": "workspace:*",
		"@rss/shared": "workspace:*",
		"@tanstack/vue-query": "^5.0.0",
		"@vueuse/core": "^13.0.0",
		"@vueuse/motion": "^3.0.0",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"dompurify": "^3.2.0",
		"lucide-vue-next": "^0.525.0",
		"pinia": "^3.0.0",
		"reka-ui": "^2.1.0",
		"tailwind-merge": "^3.0.0",
		"vue": "^3.5.0",
		"vue-router": "^4.5.0",
		"vue-virtual-scroller": "^2.0.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.0.0",
		"@cloudflare/workers-types": "^4.20250520.0",
		"@tailwindcss/vite": "^4.0.0",
		"@vitejs/plugin-vue": "^6.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "~5.9.3",
		"vite": "^7.0.0",
		"vue-tsc": "^3.0.0",
		"wrangler": "^4.0.0"
	}
}
