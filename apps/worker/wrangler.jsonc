{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "rss-reader",
    "main": "./src/index.ts",
    "compatibility_date": "2026-08-14",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "rss-reader-db",
            "database_id": "921a9db9-d8f6-4976-8715-71fd28248885",
            "migrations_dir": "../../packages/database/migrations",
            "remote": true
        }
    ],
    "kv_namespaces": [
        {
            "binding": "KV_STORE",
            "id": "b4cb2b7122dd4da1b7ef84580f276544"
        }
    ],
    "workflows": [
        {
            "name": "refresh-workflow",
            "binding": "REFRESH_WORKFLOW",
            "class_name": "RefreshWorkflow"
        }
    ],
    "triggers": {
        "crons": [
            "*/30 * * * *"
        ]
    },
    "vars": {
        "ENVIRONMENT": "development"
    }
}